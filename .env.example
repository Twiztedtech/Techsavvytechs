# Public production URL. Used for QuickBooks OAuth and password-setup links.
APP_URL="MY_APP_URL"

# Public Sanity content source. These identify a public dataset and are safe in the browser.
VITE_SANITY_PROJECT_ID="dnlgguay"
VITE_SANITY_DATASET="production"

# QuickBooks Online Configuration
QBO_CLIENT_ID="YOUR_QBO_CLIENT_ID"
QBO_CLIENT_SECRET="YOUR_QBO_CLIENT_SECRET"
# Use "sandbox" for development. Vercel production must use "production".
QBO_ENVIRONMENT="sandbox"
# These two are only fallbacks for local/manual testing. The production OAuth
# connection stores its tokens and company realm securely on the server.
QBO_ACCESS_TOKEN="YOUR_QBO_ACCESS_TOKEN"
QBO_REALM_ID="YOUR_QBO_REALM_ID"

# Server-only Firebase credentials. Add in Vercel; never expose or commit them.
FIREBASE_SERVICE_ACCOUNT_JSON=""
FIRESTORE_DATABASE_ID="ai-studio-83a5034b-71ea-4903-9fe1-2934593887b1"
# Optional explicit Storage bucket for server-side W-9 metadata validation.
FIREBASE_STORAGE_BUCKET="gen-lang-client-0345746302.firebasestorage.app"
INITIAL_ADMIN_EMAIL="will.jackson@techsavvytechs.com"
CONTACT_RECIPIENT_EMAIL="support@techsavvytechs.com"

# Resend email delivery. Keep the API key server-only.
RESEND_API_KEY=""
EMAIL_FROM="TechSavvy Contractor Portal <support@techsavvytechs.com>"
SUPPORT_EMAIL="support@techsavvytechs.com"

# Client booking and dispatch portal. Use at least 32 random bytes for the secret.
CLIENT_PORTAL_SECRET=""
CLIENT_REQUEST_ALERT_EMAILS="support@techsavvytechs.com"
CLIENT_REQUEST_ALERT_PHONES=""
CRON_SECRET=""

# Twilio transactional SMS and phone verification.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_MESSAGING_SERVICE_SID=""
TWILIO_FROM_NUMBER=""

# Resend inbound email replies. Prefer an isolated receiving subdomain.
RESEND_RECEIVING_DOMAIN="updates.techsavvytechs.com"
RESEND_WEBHOOK_SECRET=""

# Google Calendar synchronization.
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""
GOOGLE_CALENDAR_ID=""
GOOGLE_CALENDAR_WEBHOOK_TOKEN=""
# Optional fallback for environments that provision the refresh token directly.
GOOGLE_CALENDAR_REFRESH_TOKEN=""
