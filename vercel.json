{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob: https://cdn.sanity.io https://firebasestorage.googleapis.com https://*.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline' https://apis.google.com https://www.gstatic.com; frame-src 'self' https://*.firebaseapp.com https://accounts.google.com; connect-src 'self' https://*.api.sanity.io https://*.apicdn.sanity.io https://*.googleapis.com https://*.firebaseio.com https://*.firebaseapp.com https://accounts.google.com https://firestore.googleapis.com https://firebasestorage.googleapis.com; media-src 'self' https://storage.googleapis.com" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/api/client", "destination": "/api/portal/time-clock?portalOperation=clientPortal" },
    { "source": "/api/admin/client-portal", "destination": "/api/portal/time-clock?portalOperation=adminClientPortal" },
    { "source": "/api/portal/job-events", "destination": "/api/portal/time-clock?portalOperation=jobEvents" },
    { "source": "/api/auth/google-calendar", "destination": "/api/auth/quickbooks?authProvider=googleCalendar" },
    { "source": "/api/cron/client-portal", "destination": "/api/sync-vendors?portalTask=clientCron" },
    { "source": "/api/webhooks/twilio", "destination": "/api/contact?integration=twilio" },
    { "source": "/api/webhooks/resend", "destination": "/api/contact?integration=resend" },
    { "source": "/api/webhooks/google-calendar", "destination": "/api/contact?integration=googleCalendar" },
    { "source": "/api/portal/onboarding", "destination": "/api/portal/time-clock?portalOperation=onboarding" },
    { "source": "/api/admin/contractors/onboarding", "destination": "/api/admin/contractors/invite?adminOperation=onboarding" },
    { "source": "/api/admin/contractors/invitation-status", "destination": "/api/admin/contractors/invite?adminOperation=invite-status" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/|@|[^.]+\\.[^.]+).*)", "destination": "/index.html" }
  ]
}
