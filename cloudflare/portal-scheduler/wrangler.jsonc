{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "techsavvy-portal-scheduler",
  "main": "src/index.js",
  "compatibility_date": "2026-08-25",
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "vars": {
    "PORTAL_CRON_URL": "https://techsavvytechs.com/api/cron/client-portal"
  }
}
