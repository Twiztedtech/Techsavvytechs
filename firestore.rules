rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // helpers
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && request.auth.token.admin == true; }
    function isContractor() { return isSignedIn() && request.auth.token.contractor == true; }
    
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Contact Form Submissions
    match /contacts/{contactId} {
      allow read, write: if false;
    }

    // Email Triggers for Extension
    match /mail/{mailId} {
      allow read, write: if false;
    }

    // Time Entries for Contractor Portal
    match /time_entries/{entryId} {
      allow read, write: if isAdmin();
    }

    // Job Sites
    match /jobs/{jobId} {
      // Signed-in technicians can read their work-order details and attachments.
      // Writes stay limited to the administrator account.
      allow read: if isAdmin() || isContractor();
      allow create, update, delete: if isAdmin();
    }

    // Contractor Onboarding & Profiles
    match /contractors/{contractorId} {
      allow read, write: if isAdmin();
    }

    // Settings
    match /settings/{settingId} {
      allow read, write: if false;
    }
  }
}
