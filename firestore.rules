rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // helpers
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && request.auth.token.admin == true; }
    function isContractor() { return isSignedIn() && request.auth.token.contractor == true; }
    
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Contact Form Submissions
    match /contacts/{contactId} {
      allow read, write: if false;
    }

    // Client portal records are projected through authenticated server APIs.
    // Keeping these collections server-only prevents cross-company access and
    // ensures contractor private fields never reach client browsers.
    match /client_organizations/{document=**} { allow read, write: if false; }
    match /client_users/{document=**} { allow read, write: if false; }
    match /vendor_requests/{document=**} { allow read, write: if false; }
    match /appointments/{document=**} { allow read, write: if false; }
    match /job_participants/{document=**} { allow read, write: if false; }
    match /job_events/{document=**} { allow read, write: if false; }
    match /job_messages/{document=**} { allow read, write: if false; }
    match /scope_versions/{document=**} { allow read, write: if false; }
    match /notification_deliveries/{document=**} { allow read, write: if false; }
    match /calendar_connections/{document=**} { allow read, write: if false; }
    match /conversation_tokens/{document=**} { allow read, write: if false; }
    match /webhook_events/{document=**} { allow read, write: if false; }
    match /sms_preferences/{document=**} { allow read, write: if false; }

    // Email Triggers for Extension
    match /mail/{mailId} {
      allow read, write: if false;
    }

    // Time Entries for Contractor Portal
    match /time_entries/{entryId} {
      allow read, write: if isAdmin();
    }

    // Job Sites
    match /jobs/{jobId} {
      // Work orders are returned to technicians only by the authenticated
      // server endpoint after it verifies their assignment. This prevents a
      // client-side query from exposing every contractor's jobs.
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Reusable customer directory for administrator work-order creation.
    match /customers/{customerId} {
      allow read, write: if isAdmin();
    }

    // Contractor Onboarding & Profiles
    match /contractors/{contractorId} {
      allow read, write: if isAdmin();
    }

    // Settings
    match /settings/{settingId} {
      allow read, write: if false;
    }
  }
}
