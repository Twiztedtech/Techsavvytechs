rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && request.auth.token.admin == true; }
    function isContractor() { return isSignedIn() && request.auth.token.contractor == true; }

    // Contractors can submit only their own W-9 PDF. Administrators can review
    // and remove the file; no other contractor can read it.
    match /contractor-onboarding/{contractorUid}/w9/{fileName} {
      allow read: if isAdmin() || (isContractor() && request.auth.uid == contractorUid);
      allow create: if (isContractor() || isAdmin())
        && request.auth.uid == contractorUid
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Admins upload work-order documents. Signed-in field technicians can open them.
    match /work-order-documents/{jobId}/{fileName} {
      allow read: if isAdmin() || isContractor();
      allow create, update: if isAdmin()
        && request.resource.size < 25 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    // A signed-in technician may upload the completed PDF created from an
    // assigned job. The server verifies the assignment before saving metadata.
    match /signed-work-orders/{jobId}/{fileName} {
      allow read: if isAdmin() || isContractor();
      allow create: if (isAdmin() || isContractor())
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      allow update, delete: if isAdmin();
    }

    // Intake attachments are uploaded, scanned/validated, and served only by
    // server endpoints. Public and direct browser access remains disabled.
    match /client-request-documents/{requestId}/{fileName} {
      allow read, write: if false;
    }
  }
}
