rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && request.auth.token.admin == true; }
    function isContractor() { return isSignedIn() && request.auth.token.contractor == true; }

    // Contractors can submit only their own W-9 PDF. Administrators can review
    // and remove the file; no other contractor can read it.
    match /contractor-onboarding/{contractorUid}/w9/{fileName} {
      allow read: if isAdmin() || (isContractor() && request.auth.uid == contractorUid);
      allow create: if (isContractor() || isAdmin())
        && request.auth.uid == contractorUid
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Admins upload work-order documents. Signed-in field technicians can open them.
    match /work-order-documents/{jobId}/{fileName} {
      allow read: if isAdmin() || isContractor();
      allow create, update: if isAdmin()
        && request.resource.size < 25 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    // A signed-in technician may upload the completed PDF created from an
    // assigned job. The server verifies the assignment before saving metadata.
    match /signed-work-orders/{jobId}/{fileName} {
      allow read: if isAdmin() || isContractor();
      allow create: if (isAdmin() || isContractor())
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      allow update, delete: if isAdmin();
    }

    // Intake attachments are uploaded, scanned/validated, and served only by
    // server endpoints. Public and direct browser access remains disabled.
    match /client-request-documents/{requestId}/{fileName} {
      allow read, write: if false;
    }

    // Survey media is compressed in the field, then uploaded and served by
    // the survey API after it validates the technician's assignment.
    match /site-surveys/{surveyId}/{fileName} {
      allow read, write: if false;
    }

    // Forum photos. A signed-in technician or staff member uploads only into their own
    // folder; the community handler checks each file before attaching it to a post.
    match /community/uploads/{uid}/{fileName} {
      allow read: if isSignedIn() && (isAdmin() || isContractor() || request.auth.token.staffRole in ['assistant_admin', 'dispatcher']);
      allow create: if isSignedIn() && request.auth.uid == uid
        && (isAdmin() || isContractor() || request.auth.token.staffRole in ['assistant_admin', 'dispatcher'])
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Wiki images, added by whoever writes the lesson (Admin, Assistant Admin, Technician Lead).
    match /wiki-media/{slug}/{fileName} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (isAdmin() || request.auth.token.staffRole == 'assistant_admin' || (isContractor() && request.auth.token.technicianLead == true))
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Job receipts. The office uploads under /office; a technician uploads only
    // under their own /tech/{uid} folder (the server verifies their assignment
    // before saving the receipt on a timecard) and can read only their own.
    // Dispatcher has no access.
    match /job-receipts/{jobId}/office/{fileName} {
      allow read, delete: if isAdmin() || request.auth.token.staffRole in ['assistant_admin', 'office_billing'];
      allow create: if (isAdmin() || request.auth.token.staffRole in ['assistant_admin', 'office_billing'])
        && request.resource.size < 15 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
      allow update: if false;
    }
    match /job-receipts/{jobId}/tech/{uid}/{fileName} {
      allow read: if isAdmin() || request.auth.token.staffRole in ['assistant_admin', 'office_billing'] || (isContractor() && request.auth.uid == uid);
      allow create: if isContractor() && request.auth.uid == uid
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Photos attached to a time entry (manual log form). Compressed and
    // uploaded directly from the browser, same pattern as signed-work-orders.
    match /time-entry-photos/{jobId}/{fileName} {
      allow read: if isAdmin() || isContractor();
      allow create: if (isAdmin() || isContractor())
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow update, delete: if isAdmin();
    }
  }
}
